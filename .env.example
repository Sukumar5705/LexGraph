# ---------------------------------------------------------------------------
# Environment variables — copy this file to .env and fill in real values.
# NEVER commit the real .env file or real credentials to version control.
# ---------------------------------------------------------------------------

# --- Application ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# --- LLM Provider (pluggable — fill in whichever provider you use) ---
LLM_PROVIDER=REPLACE_ME               # e.g. anthropic / openai / local
LLM_API_KEY=REPLACE_ME
LLM_MODEL_NAME=REPLACE_ME

# --- Embedding Model ---
EMBEDDING_PROVIDER=REPLACE_ME
EMBEDDING_API_KEY=REPLACE_ME
EMBEDDING_MODEL_NAME=REPLACE_ME

# --- Neo4j (Knowledge Graph) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=REPLACE_ME
NEO4J_PASSWORD=REPLACE_ME
NEO4J_DATABASE=neo4j

# --- Vector Store ---
VECTOR_STORE_PROVIDER=REPLACE_ME      # e.g. chroma / qdrant / pinecone / weaviate
VECTOR_STORE_URL=REPLACE_ME
VECTOR_STORE_API_KEY=REPLACE_ME

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
